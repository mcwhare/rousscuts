<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Manage reviews' }) %>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <%- include('partials/topbar') %>
    <div class="admin-shell wide">
        <div class="admin-heading">
            <h1>Manage reviews</h1>
            <form action="/booking-settings" method="get">
                <button class="btn btn-secondary" type="submit">Back to admin settings</button>
            </form>
        </div>
        <table class="data-table">
            <caption>Customer reviews</caption>
            <tr>
                <th>Customer</th>
                <th>Rating</th>
                <th>Review</th>
                <th>Status</th>
                <th>Options</th>
            </tr>
            <% if (rows.length === 0) { %>
                <tr><td colspan="5" style="color: var(--text-muted);">No reviews yet.</td></tr>
            <% } %>
            <% rows.forEach(function(row) { %>
                <tr>
                    <td><%= row.name %></td>
                    <td><%= row.rating %>/5</td>
                    <td class="review-text-cell"><%= row.review_text %></td>
                    <td>
                        <% if (row.approved) { %>
                            <span class="status-badge">Published</span>
                        <% } else { %>
                            <span class="status-badge pending">Hidden</span>
                        <% } %>
                    </td>
                    <td>
                        <div class="row-actions">
                            <form action="/edit-review" method="get">
                                <input type="hidden" name="id" value="<%= row.id %>">
                                <button type="submit">Edit</button>
                            </form>
                            <form action="/delete-review" method="post" onsubmit="return confirm('Delete this review?');">
                                <input type="hidden" name="id" value="<%= row.id %>">
                                <button type="submit">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% }) %>
        </table>
        <form action="/booking-settings" method="get">
            <button class="btn btn-secondary" type="submit" style="margin-top: 20px;">Back to admin menu</button>
        </form>
    </div>
    <%- include('partials/scripts') %>
</body>
</html>
