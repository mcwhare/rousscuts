<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Login' }) %>
    <link rel="stylesheet" href="/css/style1.css">
</head>
<body>
    <div class="login-shell">
        <span class="wordmark" style="font-family: var(--font-display); font-weight:600; display:block; text-align:center; margin-bottom:26px;">Rousscuts</span>
        <div class="panel">
            <h1>Admin login</h1>
            <form action="/login" method="post">
                <div class="field">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" required>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required>
                </div>
                <button class="btn btn-primary btn-block" name="submit" type="submit" id="submit">Log in</button>
            </form>
        </div>
    </div>
    <%- include('partials/scripts') %>
</body>
</html>
