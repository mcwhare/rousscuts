<h3><%= isToday ? 'Today, ' : '' %><%= dateLabel %></h3>

<% if (msg && msg.type === 'success') { %>
    <div class="alert-success"><%= msg.text %></div>
<% } else if (msg && msg.type === 'error') { %>
    <div class="alert-failure"><%= msg.text %></div>
<% } %>

<% if (slots.length === 0) { %>
    <!-- Jamie hasn't added availability for this day at all -->
    <div style="margin-bottom: 20px;">
        <p style="color: var(--text-muted); margin-bottom: 12px;">No availability set for this day.</p>
        <% if (nextAvailable) { %>
            <a href="/calendar?date=<%= nextAvailable %>" class="btn-next-available" data-date="<%= nextAvailable %>" data-month="<%= nextAvailableMonth %>" data-year="<%= nextAvailableYear %>">Go to next available</a>
        <% } %>
    </div>
<% } else { %>
    
    <!-- Show a warning if the day is completely full -->
    <% if (!hasOpenSlot) { %>
        <div style="margin-bottom: 20px;">
            <p style="color: var(--text-muted); margin-bottom: 12px;">This day is fully booked. Click a time below to join the waitlist.</p>
        </div>
    <% } %>

    <!-- ALWAYS render the time grid if slots exist -->
    <% ['morning', 'afternoon', 'evening'].forEach(function(bucket) { %>
        <% var bucketSlots = slots.filter(function(s) { return s.bucket === bucket; }); %>
        <% if (bucketSlots.length > 0) { %>
            <div class="time-section">
                <h4><%= bucket.charAt(0).toUpperCase() + bucket.slice(1) %></h4>
                <div class="time-grid">
                    <% bucketSlots.forEach(function(slot) { %>
                        <% if (slot.booked) { %>
                            <a href="#openModal" class="time-pill booked" data-timeslot="<%= slot.value %>" data-label="<%= slot.label %>">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px; vertical-align: -2px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                <%= slot.label %>
                            </a>
                        <% } else { %>
                            <a href="#openModal" class="time-pill" data-timeslot="<%= slot.value %>" data-label="<%= slot.label %>"><%= slot.label %></a>
                        <% } %>
                    <% }) %>
                </div>
            </div>
        <% } %>
    <% }) %>

    <!-- Add the 'Next Available' button at the bottom if the day is full -->
    <% if (!hasOpenSlot && nextAvailable) { %>
        <div style="margin-top: 24px;">
            <a href="/calendar?date=<%= nextAvailable %>" class="btn-next-available" data-date="<%= nextAvailable %>" data-month="<%= nextAvailableMonth %>" data-year="<%= nextAvailableYear %>">Go to next available</a>
        </div>
    <% } %>
<% } %>