<h3><%= isToday ? 'Today, ' : '' %><%= dateLabel %></h3>

<% if (msg && msg.type === 'success') { %>
    <div class="alert-success"><%= msg.text %></div>
<% } else if (msg && msg.type === 'error') { %>
    <div class="alert-failure"><%= msg.text %></div>
<% } %>

<% if (!hasOpenSlot) { %>
    <p class="no-availability">
        <% if (nextAvailable) { %>No availability until <%= nextAvailableLabel %>.<% } else { %>No upcoming availability &mdash; check back soon.<% } %>
    </p>
    <% if (nextAvailable) { %>
        <a href="/calendar?date=<%= nextAvailable %>" class="btn-next-available" data-date="<%= nextAvailable %>" data-month="<%= nextAvailableMonth %>" data-year="<%= nextAvailableYear %>">Go to next available</a>
    <% } %>
<% } else { %>
    <% ['morning', 'afternoon', 'evening'].forEach(function(bucket) { %>
        <% var bucketSlots = slots.filter(function(s) { return s.bucket === bucket; }); %>
        <% if (bucketSlots.length > 0) { %>
            <div class="time-section">
                <h4><%= bucket.charAt(0).toUpperCase() + bucket.slice(1) %></h4>
                <div class="time-grid">
                    <% bucketSlots.forEach(function(slot) { %>
                        <% if (slot.booked) { %>
                            <button type="button" class="time-pill booked" disabled><%= slot.label %></button>
                        <% } else { %>
                            <a href="#openModal" class="time-pill" data-timeslot="<%= slot.value %>" data-label="<%= slot.label %>"><%= slot.label %></a>
                        <% } %>
                    <% }) %>
                </div>
            </div>
        <% } %>
    <% }) %>
<% } %>
